# Local live-model configuration for the Golden Eagle AI Cabinet backend.
# Copy this file to `cabinet.local.env` (gitignored) at the repo root and fill
# in your endpoint's values. KEY=VALUE lines only, and only CABINET_* keys are
# read, and variables already set in the real environment win.

# Base URL of the configured model endpoint (a chat-completions endpoint).
CABINET_LLM_BASE_URL=https://your-endpoint.example/v1
# The model id sent to the endpoint (never shown in the UI or recordings).
CABINET_LLM_MODEL=your-model-id
# What the UI shows as the source of the explanation (default "live model").
CABINET_LLM_LABEL=live model
# Sent as reasoning_effort. Reasoning models otherwise spend the whole output
# budget thinking and answer nothing. Leave empty to omit the field. A local
# thinking model behind an OpenAI-compatible server may ignore "low" and honour
# only "none", which turns its hidden reasoning off.
CABINET_LLM_REASONING_EFFORT=low
# The output budget per call, sent as max_tokens (default 2048, 256 to 32768).
# Hidden reasoning counts against it; running out makes the section
# unavailable, never half written.
# CABINET_LLM_MAX_TOKENS=2048
# Corrective tries after the model's answer fails validation (default 1).
# Each try resends the same inputs plus a plain-words reason and no data, and
# the answer is validated again. 0 turns it off. Capped at 3.
# CABINET_VALIDATION_RETRIES=1
# The endpoint key. Environment-only is fine too. Never commit a real key.
CABINET_LLM_API_KEY=your-key-here

# Security (see docs/SECURITY.md):
# Signs session cookies. Required (32+ bytes) when CABINET_ENV=production.
# Outside production an unset key degrades to an ephemeral one (sessions do
# not survive restarts). Generate one: python3 -c 'import secrets; print(secrets.token_hex(32))'
# CABINET_SECRET_KEY=
# Set to "production" for fail-closed startup, Secure cookies, and HSTS.
# CABINET_ENV=production
# Bind address. Defaults to 127.0.0.1 and must be set explicitly in
# production (set it to bind anything else).
# CABINET_BIND=127.0.0.1
# Users and sessions database path (default var/cabinet.db).
# CABINET_DB=var/cabinet.db

# Session lifetime in hours (default 12).
# CABINET_SESSION_TTL_HOURS=12

# Alternative: read the key from one named variable's line in another env
# file (no other line of that file is ever read):
# CABINET_LLM_API_KEY_FILE=/path/to/another.env
# CABINET_LLM_API_KEY_VAR=SOME_KEY_NAME

# The Ellucian Ethos import (make import-ethos; docs/ELLUCIAN.md).
# Both keys come from FILES, never from env values, so they cannot leak
# through a process listing or a dumped environment.
# The institution's Ethos Integration base URL (its edge, HTTPS in production).
# CABINET_ETHOS_BASE_URL=https://ethos.example.edu
# File holding the Ethos API key (0600, outside the repo).
# CABINET_ETHOS_API_KEY_FILE=/path/to/ethos-api-key
# File holding the pseudonym key for the keyed hash. It never leaves the
# institution, is never stored by the app, and is never printed. Rotating or
# losing it makes a re-import unlinkable to previous imports.
# CABINET_PSEUDONYM_KEY_FILE=/path/to/pseudonym-key
# Optional JSON overrides for Ethos resource names and versions per tenant
# (validated: lowercase dashed names only, integer versions, and the
# never-requested deny list applies; "persons" is always refused):
# CABINET_ETHOS_RESOURCES={"person_holds": {"path": "person-holds", "version": 5}}
# Date-semantics time zone for the export (default America/Chicago).
# CABINET_ETHOS_TIMEZONE=America/Chicago
# Export directory (default var/exports/).
# CABINET_EXPORTS_DIR=var/exports

# Sending approved messages to offices. The default, outbox, writes each
# message to var/outbox/<institution>/<id>.eml and nothing leaves the machine.
# CABINET_OUTBOUND=outbox
# Real delivery needs every setting below. The password is read from a file,
# never an env value, and the file must be mode 0600. Port 465 uses SMTPS,
# any other port uses STARTTLS, and the server certificate is always verified.
# CABINET_OUTBOUND=smtp
# CABINET_SMTP_HOST=smtp.example.edu
# CABINET_SMTP_PORT=587
# CABINET_SMTP_USER=cabinet@example.edu
# CABINET_SMTP_FROM=cabinet@example.edu
# CABINET_SMTP_PASSWORD_FILE=/secure/path/smtp-password

# Rate limits, in requests per minute (defaults shown). Per client address:
# everyone behind one campus address shares this bucket, so it is generous.
# CABINET_RATE_GENERAL_PER_MIN=600
# Per signed-in session: what paces one person.
# CABINET_RATE_SESSION_PER_MIN=120
# Questions asked (POST /ask), per client address.
# CABINET_RATE_ASK_PER_MIN=5
