# deploy/systemd/cabinet-backup.timer — daily backup at 03:17 local;
# Persistent=true catches up a run missed while the machine was off.
# Validate on the target host: systemd-analyze verify cabinet-backup.timer

[Unit]
Description=Golden Eagle AI Cabinet daily backup

[Timer]
OnCalendar=*-*-* 03:17:00
Persistent=true

[Install]
WantedBy=timers.target
