<?xml version="1.0" encoding="UTF-8"?>
<!--
  deploy/launchd/com.campuslens.app-backup.plist — daily backup with
  rotation: deploy/backup.sh at 03:17 local, keeping the newest 14.

  Install (as the operator):
    cp deploy/launchd/com.campuslens.app-backup.plist ~/Library/LaunchAgents/
    launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.campuslens.app-backup.plist

  Replace /opt/campuslens with the deploy location. Validate:
    plutil -lint deploy/launchd/com.campuslens.app-backup.plist
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.campuslens.app-backup</string>
	<key>ProgramArguments</key>
	<array>
		<string>/opt/campuslens/deploy/backup.sh</string>
	</array>
	<key>WorkingDirectory</key>
	<string>/opt/campuslens</string>
	<!-- The same env file as the app plist: launchd cannot source a file,
	     so it points at it and deploy/backup.sh loads it — the backup must
	     see the same CABINET_DB (and friends), or it snapshots the wrong
	     path. -->
	<key>EnvironmentVariables</key>
	<dict>
		<key>CABINET_LOCAL_ENV</key>
		<string>/etc/campuslens/cabinet.env</string>
	</dict>
	<key>StartCalendarInterval</key>
	<dict>
		<key>Hour</key>
		<integer>3</integer>
		<key>Minute</key>
		<integer>17</integer>
	</dict>
	<key>StandardOutPath</key>
	<string>/opt/campuslens/var/backup.log</string>
	<key>StandardErrorPath</key>
	<string>/opt/campuslens/var/backup.error.log</string>
</dict>
</plist>
